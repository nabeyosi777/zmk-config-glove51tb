#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Layer Numbering

#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        scroll {
            bindings = <&mo 5>;
            key-positions = <21 22>;
        };
    };

    behaviors {
        sensor_rotate_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_wheel_scroll: mouse_wheel_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    macros {
        mouse_layer: mouse_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 3 &kp F17>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp F17 &mo 3>;

            label = "MOUSE_LAYER";
        };

        sym_layer: sym_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 2 &kp F16>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp F16 &mo 2>;

            label = "SYM_LAYER";
        };

        fun_layer: fun_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 4 &kp F13>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp F13 &mo 4>;

            label = "FUN_LAYER";
        };

        default_layer: default_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 0 &kp F15>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp F15 &mo 0>;

            label = "DEFAULT_LAYER";
        };

        mouse_toggle: mouse_tap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&tog 3>, <&macro_tap>, <&kp F17>;

            label = "MOUSE_TAP";
        };

        default_to: default_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&to 0>, <&macro_tap>, <&kp F15>;

            label = "DEFAULT_TOGGLE";
        };

        fun_toggle: fun_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&tog 4>, <&macro_tap>, <&kp F13>;

            label = "FUN_TOGGLE";
        };

        num_layer: num_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 1 &kp F14>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp F14 &mo 1>;

            label = "NUM_LAYER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
&kp ESC           &kp Q          &kp W         &kp E         &kp R       &kp T                                  &kp Y          &kp U  &kp I      &kp O    &kp P          &kp BSPC
&kp TAB           &kp A          &kp S         &kp D         &kp F       &kp G      &none        &kp RA(GRAVE)  &kp H          &kp J  &kp K      &kp L    &kp SEMI       &kp ENTER
&kp LEFT_SHIFT    &kp Z          &kp X         &kp C         &kp V       &kp B      &fun_toggle  &kp SPACE      &kp N          &kp M  &kp COMMA  &kp DOT  &kp FSLH       &kp RIGHT_SHIFT
&kp LEFT_CONTROL  &kp LA(GRAVE)  &kp LEFT_GUI  &kp LEFT_ALT  &num_layer  &kp SPACE  &default_to  &sym_layer     &mouse_toggle                             &kp BACKSLASH  &kp RALT
            >;

            sensor-bindings = <&mouse_wheel_scroll SCRL_UP SCRL_DOWN>;
        };

        number_layer {
            label = "NUM";
            bindings = <
&trans  &none     &kp UP    &none      &kp F1  &kp F2                  &kp STAR      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS  &kp BSPC
&trans  &kp LEFT  &kp DOWN  &kp RIGHT  &kp F3  &kp F4  &trans  &trans  &kp SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS   &kp ENTER
&trans  &kp F5    &kp F6    &kp F7     &kp F8  &kp F9  &trans  &trans  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL  &kp RIGHT_SHIFT
&trans  &kp F10   &kp F11   &kp F12    &trans  &trans  &trans  &trans  &trans                                                  &kp DOT    &kp COMMA
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp AMPERSAND                  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS      &kp EQUAL         &kp TILDE       &kp BSPC
&kp CARET        &kp SINGLE_QUOTE   &kp PIPE  &trans      &trans       &trans         &trans  &trans  &kp LEFT_BRACE        &kp RBRC               &kp PLUS       &kp STAR          &kp AT_SIGN     &kp ENTER
&trans           &trans             &trans    &trans      &trans       &trans         &trans  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LESS_THAN  &kp GREATER_THAN  &kp QMARK       &kp RIGHT_SHIFT
&trans           &trans             &trans    &trans      &trans       &trans         &trans  &trans  &trans                                                                        &kp UNDERSCORE  &kp RALT
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &none     &kp LC(LS(T))    &kp LC(F4)         &kp LC(T)   &none  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4  &mkp LCLK        &mkp RCLK          &none       &none  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB5  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp K_MUTE  &none  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                    &none  &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6                  &none     &kp LC(LS(T))    &kp LC(F4)         &kp LC(T)   &kp NUMBER_7  &trans
&kp Q         &kp W         &kp E         &kp R         &kp T         &kp Y         &trans  &trans  &mkp MB4  &mkp LCLK        &mkp RCLK          &none       &kp U         &trans
&kp A         &kp S         &kp D         &kp F         &kp G         &kp H         &trans  &trans  &mkp MB5  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp K_MUTE  &kp J         &trans
&kp Z         &kp X         &kp C         &kp V         &kp B         &kp N         &trans  &trans  &trans                                                    &kp M         &trans
            >;

            sensor-bindings = <&sensor_rotate_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };
    };
};
